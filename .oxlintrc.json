{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // проект на новом JSX-трансформе, импортировать React в область видимости не нужно
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    // 50 строк на функцию для JSX мало: разметка занимает место, а дробить её
    // ради счётчика - хуже, чем прочитать компонент целиком
    "eslint/max-lines-per-function": ["warn", { "max": 120 }],
    // корневой компонент по определению собирает все остальные
    "import/max-dependencies": "off",
    // css и setup подключаются ради побочного эффекта, присваивать нечего
    "import/no-unassigned-import": "off",
    "unicorn/no-null": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/prefer-query-selector": "off",
    // role="group" на div - валидный ARIA, предлагаемые теги сюда не подходят
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        // ?. и ?? в тестах - это сужение типа под noUncheckedIndexedAccess,
        // а не ветвление логики
        "vitest/no-conditional-in-test": "off",
        // явный undefined в аргументе и есть проверяемый случай
        "unicorn/no-useless-undefined": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "tools"]
}
